# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eduknight?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS + password reset links)
CLIENT_URL=http://localhost:5500

# Email service (verification & password reset emails)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@eduknight.com