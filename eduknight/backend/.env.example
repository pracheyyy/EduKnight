NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/eduknight

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Frontend origin (for CORS + reset link generation)
CLIENT_URL=http://localhost:3000

# Email (placeholder — plug in SMTP or a provider like Resend/SendGrid)
